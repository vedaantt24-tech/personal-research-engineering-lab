ENVIRONMENT=production

# Railway Postgres connection string (example format)
DATABASE_URL=postgresql+psycopg://postgres:replace-with-railway-password@containers-us-west-...railway.app:5432/railway

SECRET_KEY=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

CORS_ORIGINS=https://your-frontend-domain.vercel.app
AUTO_CREATE_TABLES=false
PUBLIC_SITE_URL=https://your-frontend-domain.vercel.app

# Backend media storage
STORAGE_DRIVER=s3
MEDIA_ROOT=/app/data/media
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key

# Optional SMTP / Turnstile
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
GITHUB_TIMEOUT_SECONDS=8

# Request paths that the backend must expose publicly
INTERNAL_API_URL=https://your-backend-domain.up.railway.app/api/v1

# Frontend environment variables belong in Vercel; these are examples only.
NEXT_PUBLIC_API_URL=https://your-backend-domain.up.railway.app/api/v1
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
