ENVIRONMENT=production

# Neon PostgreSQL connection
DATABASE_URL=postgresql+psycopg://postgres:replace-with-postgres-password@db:5432/personal_lab
POSTGRES_DB=personal_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

SECRET_KEY=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

CORS_ORIGINS=https://www.your-domain.example
AUTO_CREATE_TABLES=false
PUBLIC_SITE_URL=https://www.your-domain.example

# Backend media storage
STORAGE_DRIVER=s3
MEDIA_ROOT=/app/data/media
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key
S3_SECRET_ACCESS_KEY=your-r2-secret-key

# Optional SMTP / Turnstile
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
GITHUB_TIMEOUT_SECONDS=8

# Server-side Next.js -> FastAPI URL on the private Compose network
INTERNAL_API_URL=http://backend:8000/api/v1

# Public frontend build values; set these before building the frontend image.
NEXT_PUBLIC_API_URL=https://api.your-domain.example/api/v1
NEXT_PUBLIC_SITE_URL=https://www.your-domain.example
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
