DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/personal_lab
SECRET_KEY=replace-with-a-long-random-secret
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

AUTO_CREATE_TABLES=true
MEDIA_ROOT=/app/data/media

# Storage
STORAGE_DRIVER=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_SITE_URL=http://localhost:3000

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
GITHUB_TIMEOUT_SECONDS=8

# Server-side Next.js → FastAPI URL; for Docker use http://backend:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1

# Frontend values stay in /frontend/.env.example and Vercel dashboard envs
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
